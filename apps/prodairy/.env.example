# Stopgap access code for the ProDairy Dashboard's client-side PasswordGate.
# This is NOT real security - it's bundled into the shipped JS and readable
# via dev tools by anyone determined enough. It only deters a link that gets
# shared or indexed by accident, until real Supabase auth (Phase 3) exists.
#
# Copy this file to .env, set your own value, and set the same variable in
# Vercel's project settings for the deployed site (Settings -> Environment
# Variables). Never commit the real .env file.
VITE_PRODAIRY_ACCESS_CODE=changeme
